<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- load parameter -->
  <xacro:property name="vehicle_info" value="${xacro.load_yaml('$(find autobus_vehicle_description)/config/vehicle_info.param.yaml')}"/>

  <!-- vehicle body, no float need to find -->
  <link name="base_link">
    <visual>
      <origin xyz="1.27 -0.37 0" rpy="${pi/2.0} 0 ${pi}"/> 
      <geometry>
        <mesh filename="package://autobus_vehicle_description/mesh/Full_Assem.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>
</robot>
